# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.railway.app,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://yourdomain.com

# Security Settings (Production)
DJANGO_SECURE_SSL_REDIRECT=True

# Database (Railway will auto-provide DATABASE_URL)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Email Configuration (Optional - for password reset)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
